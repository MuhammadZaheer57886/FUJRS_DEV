{
  "name": "fujrs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:generate:optional": "node --experimental-strip-types scripts/generate-seed.mjs",
    "types:generate": "supabase gen types typescript --linked > src/lib/data/supabase/database.types.ts",
    "images": "node scripts/optimise-images.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "next": "15.5.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "eslint-config-prettier": "^9.1.2",
    "postcss": "8.5.16",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4"
  }
}
