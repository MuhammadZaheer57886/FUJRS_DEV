# FUJRS — environment template.
#
# Copy to .env.local (already gitignored) and fill in. NEVER commit real keys.
#
#   cp .env.example .env.local
#
# The app runs with NO configuration while NEXT_PUBLIC_DATA_BACKEND=local —
# everything (cart, wishlist, measurements, orders, accounts) persists to the
# browser and dashboards render sample data from src/lib/auth/demoData.ts.
#
# There are no demo logins: register at /register and the FIRST account on a
# fresh browser becomes Super Admin. Create the rest from the dashboard.
#
# Only the Supabase values below are needed to switch the real backend on.
# Setup instructions: BACKEND_SETUP.md

NEXT_PUBLIC_APP_NAME="FUJRS"

# Which data adapter to use: "local" (browser storage) or "supabase".
# See BACKEND_SETUP.md §1 — components never learn which one is running.
NEXT_PUBLIC_DATA_BACKEND="local"


# --- Supabase -------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.

# Safe to expose. NEXT_PUBLIC_* values are inlined into the JavaScript bundle
# at build time and are public forever.
NEXT_PUBLIC_SUPABASE_URL=""

# Also safe to expose — BUT ONLY BECAUSE ROW LEVEL SECURITY IS ON.
# This key carries no authority by itself; RLS policies decide what each
# request may read. With RLS off it reads the entire database.
# See supabase/migrations/20260804000006_rls.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# WARNING: SECRET. Bypasses Row Level Security completely — a full database
# credential.
#
#   * server-side code ONLY (route handlers, server actions, server components)
#   * never in a component, never in a NEXT_PUBLIC_* var, never in git
#   * if it leaks, rotate it in the dashboard immediately
#
# Note the missing NEXT_PUBLIC_ prefix. That is the whole difference.
SUPABASE_SERVICE_ROLE_KEY=""
